{
  "renderer" : {
    "componentOverrides" : {
      "$" : {
        "definition" : "@widget/c/customerProfileCard",
        "attributes" : {
          "customerName" : "{!customerProfile.customerName}",
          "age" : "{!customerProfile.age}",
          "netWorth" : "{!customerProfile.netWorth}",
          "totalInvestment" : "{!customerProfile.totalInvestment}",
          "currentPortfolio" : "{!customerProfile.currentPortfolio}",
          "futureGoal" : "{!customerProfile.futureGoal}",
          "accountIdUsed" : "{!customerProfile.accountIdUsed}",
          "unifiedHexId" : "{!customerProfile.unifiedHexId}",
          "resultMessage" : "{!customerProfile.resultMessage}"
        }
      }
    }
  }
}